/*
 * conf/test.config
 * ------------------------------------------------------------------
 * The test profile: a handful of sequences, no network, seconds not minutes.
 *
 * What it is for: proving the pipeline still WIRES UP correctly after a change -
 * every process runs, every file is produced, every script's inputs are where it
 * expects them. It is not a scientific check. Twelve sequences give a
 * meaningless tree and a nonsense clock rate, and that is fine; a green test
 * means "safe to run the real thing", not "the answer is right".
 *
 * It starts from a pre-computed Nextclade result because the real entry point
 * needs to download a reference dataset, and a test that depends on a network
 * service is a test that fails for reasons unrelated to your code.
 *
 *   nextflow run . -profile test,conda
 */

params {
    input_mode        = 'nextclade'

    metadata          = "${projectDir}/tests/data/metadata.tsv"
    nextclade_tsv     = "${projectDir}/tests/data/nextclade.tsv"
    aligned_fasta     = "${projectDir}/tests/data/aligned.fasta"
    gff               = "${projectDir}/tests/data/genome_annotation.gff3"

    // only the whole-genome set: the E-gene tree adds minutes and tests nothing
    // new about the wiring
    sets              = 'wg'

    // fixed model instead of ModelFinder, which would try ~968 models
    iqtree_model      = 'GTR+G'
    bootstrap         = 1000      // IQ-TREE's minimum for ultrafast bootstrap

    // keep every sequence: with a tiny dataset the real thresholds would empty it
    min_cov_wg        = 0.10
    min_cov_eg        = 0.10
    context_per_group = 5

    outdir            = 'results_test'
    // params are resolved top-down, so tracedir must be set here too
    tracedir          = 'results_test/pipeline_info'
}

process {
    cpus   = 1
    memory = '2.GB'
    time   = '30.m'
}
