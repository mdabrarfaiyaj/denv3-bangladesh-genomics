/*
 * nextflow.config
 * ------------------------------------------------------------------
 * Parameters, profiles and resource limits.
 *
 * On profiles: this machine has 4 cores and ~6 GB of RAM, so the `conda`
 * profile is what runs locally - it reuses the existing denv3 environment and
 * adds no container overhead. The `docker` profile exists and is exercised by
 * GitHub Actions on every push, which is a stronger reproducibility claim than
 * "it worked on my laptop": CI proves the containerised path works on a clean
 * machine, not just here.
 */

manifest {
    name            = 'denv3-bangladesh-genomics'
    author          = 'Md. Abrar Faiyaj'
    description     = 'Genomic epidemiology of DENV-3 in Bangladesh, 2017-2025'
    mainScript      = 'main.nf'
    /* Tested on 24.10.4 and 26.10.4. The lower bound is 24.10 because
     * process.resourceLimits is used; the config and script also satisfy the
     * strict syntax that Nextflow 25+ enforces (no `def` in config, no
     * top-level statements in main.nf). Do not widen this range without
     * actually running the test profile on the older version - '>=23.10.0'
     * was claimed here before and was not true. */
    nextflowVersion = '>=24.10.0'
    version         = '1.0.0'
}

params {
    // ---- entry point -------------------------------------------------------
    // 'raw'       : from the NCBI download, runs Nextclade (needs network)
    // 'nextclade' : from an existing Nextclade result (no network; used by CI)
    input_mode          = 'raw'

    // raw mode inputs
    data_report         = 'data/raw/denv3_all/ncbi_dataset/data/data_report.jsonl'
    genomic_fasta       = 'data/raw/denv3_all/ncbi_dataset/data/genomic.fna'

    // nextclade mode inputs
    metadata            = null
    nextclade_tsv       = null
    aligned_fasta       = null
    gff                 = null

    // ---- Nextclade ---------------------------------------------------------
    // The tag is PINNED. Lineage names in community datasets get revised, and an
    // unpinned rerun would silently relabel every figure in the paper.
    nextclade_name      = 'community/v-gen-lab/dengue/denv3'
    nextclade_tag       = '2026-10-06--17-37-18Z'

    // ---- sequence selection ------------------------------------------------
    seed                = 1
    context_per_group   = 2
    min_cov_wg          = 0.80
    min_cov_eg          = 0.70
    // '3I' is a paraphyletic PARENT label and cannot root a tree; pass a sister
    // lineage such as 3II_B for genuine outgroup rooting.
    outgroup_lineages   = '3I'
    outgroup_max        = 0

    // ---- phylogenetics -----------------------------------------------------
    sets                = 'wg eg'
    iqtree_model        = 'MFP'   // ModelFinder; the test profile overrides this
    bootstrap           = 1000    // IQ-TREE requires >= 1000 for UFBoot

    // ---- conda -------------------------------------------------------------
    /* Path to an EXISTING conda environment to reuse, e.g.
     *     nextflow run . -profile conda --conda_env "$CONDA_PREFIX"
     * Left null, the conda profile builds a fresh environment from
     * environment.yml - correct for a stranger or for CI, but wasteful on a
     * machine that already has the environment, and slow: solving the
     * Bioconductor packages takes many minutes. */
    conda_env           = null

    // ---- resource ceilings -------------------------------------------------
    // Every request is capped to these by process.resourceLimits below.
    max_cpus            = Runtime.runtime.availableProcessors()
    max_memory          = '5.GB'
    max_time            = '8.h'

    // ---- output ------------------------------------------------------------
    outdir              = 'results'
    tracedir            = "${params.outdir}/pipeline_info"
}

// --------------------------------------------------------------- resources ---
/*
 * Deliberately modest. A four-core laptop and a two-core CI runner both have to
 * run this, and IQ-TREE will take every core it is offered unless told not to.
 *
 * resourceLimits caps every request to what the machine actually has, so a
 * process asking for 4 cpus on a 2-core runner is quietly given 2 instead of
 * failing with "requirement exceeds available CPUs". Override on the command
 * line when needed:  --max_cpus 2 --max_memory '3.GB'
 *
 * (An earlier version computed the cap with `def maxCpus = ...`. Nextflow 25+
 * uses a strict config syntax that forbids variable declarations in config
 * files, so that version failed to parse. resourceLimits is the supported way.)
 */

process {
    resourceLimits = [
        cpus:   params.max_cpus,
        memory: params.max_memory,
        time:   params.max_time
    ]

    /* pipefail is not optional here. Several processes pipe a script into `tee`
     * to keep a log, and without pipefail the exit status is tee's, not the
     * script's - so a step that failed outright would be reported as a success
     * and the pipeline would publish empty logs. This was a real bug, caught
     * only because the test logs came out empty. */
    shell  = ['/bin/bash', '-euo', 'pipefail']

    cpus   = 1
    memory = '2.GB'
    time   = '4.h'
    errorStrategy = 'terminate'

    withLabel: light  { cpus = 1; memory = '2.GB' }
    withLabel: medium { cpus = 2; memory = '3.GB' }
    withLabel: heavy  { cpus = 4; memory = '4.GB'; time = '8.h' }
}

// ---------------------------------------------------------------- profiles ---

profiles {

    // Local default on this machine: no containers, reuse the conda env.
    conda {
        conda.enabled          = true
        conda.cacheDir         = "${System.getProperty('user.home')}/.nextflow-conda"
        /* Reuse an existing environment when one is given, otherwise build from
         * the spec. useMamba is deliberately OFF: it fails outright when mamba
         * is not installed, and when --conda_env points at an existing
         * environment nothing needs solving anyway. Install mamba and pass
         * -with-conda.useMamba=true if you do want a faster build. */
        conda.useMamba         = false
        process.conda          = params.conda_env ?: "${projectDir}/environment.yml"
        docker.enabled         = false
        singularity.enabled    = false
    }

    // Used by CI, and by anyone with Docker. Images are pinned by digest-style
    // version tags from BioContainers rather than :latest.
    docker {
        docker.enabled         = true
        // The container sees the work directory but not the project root,
        // so ${projectDir}/scripts/*.py was invisible inside it. Mount
        // just scripts/ - not the project root, which contains work/.
        docker.runOptions      = "-u \$(id -u):\$(id -g) -v ${projectDir}/scripts:${projectDir}/scripts:ro"
        conda.enabled          = false
        process {
            withName: 'NEXTCLADE_DATASET|NEXTCLADE_RUN' {
                container = 'quay.io/biocontainers/nextclade:3.8.2--h9ee0642_0'
            }
            withName: 'BUILD_TREE' {
                container = 'quay.io/biocontainers/iqtree:3.1.4--h8471819_0'
            }
            withName: 'CLOCK_CHECK|DATE_AND_INTRODUCTIONS' {
                container = 'quay.io/biocontainers/treetime:0.12.1--pyhdfd78af_0'
            }
            // Every Python process needs pandas; several also need Biopython.
            // The treetime image carries both as dependencies. The biopython
            // image used here before has no pandas, which failed at runtime
            // rather than at pull.
            withName: 'PARSE_METADATA|SUMMARISE_CLADES|LINEAGE_GEOGRAPHY|CURATION_AUDIT|MUTATION_PROFILE|SELECT_SEQUENCES|INSPECT_TREES' {
                container = 'quay.io/biocontainers/treetime:0.12.1--pyhdfd78af_0'
            }
        }
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        conda.enabled          = false
        docker.enabled         = false
    }

    // Tiny dataset, no network, fast settings. This is what CI runs, and what
    // you run after changing anything, before committing.
    test {
        includeConfig 'conf/test.config'
    }

    // For a cluster. Untested here - stated plainly rather than implied.
    slurm {
        process.executor       = 'slurm'
        process.queue          = 'short'
    }
}

// ------------------------------------------------------------------ reports ---

timeline { enabled = true; file = "${params.tracedir}/execution_timeline.html"; overwrite = true }
report   { enabled = true; file = "${params.tracedir}/execution_report.html";   overwrite = true }
trace    { enabled = true; file = "${params.tracedir}/execution_trace.txt";     overwrite = true }
dag      { enabled = true; file = "${params.tracedir}/pipeline_dag.html";       overwrite = true }

// ------------------------------------------------------------- completion ---
/* Nextflow 25+ uses a strict script syntax that forbids top-level statements,
 * so this handler lives in the config rather than in main.nf. */
workflow.onComplete = {
    println """
==========================================================
 ${workflow.success ? 'Completed' : 'FAILED'}
 duration : ${workflow.duration}
 outdir   : ${params.outdir}
 report   : ${params.tracedir}/execution_report.html
==========================================================
"""
}
